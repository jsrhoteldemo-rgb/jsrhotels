# PostgreSQL connection string (runtime / pooled)
# Local example:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jsr_hotel"

# Direct DB connection for Prisma migrations (Neon direct/non-pooled URL)
# Local example can be same as DATABASE_URL:
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/jsr_hotel"

# Frontend -> API base URL
# Local frontend uses Vite on 5173 and backend on 4000.
VITE_API_BASE_URL="http://localhost:4000"

# API server config
API_PORT=4000
JWT_SECRET="replace-with-a-long-random-secret"
CLIENT_ORIGIN="http://localhost:5173"
UPLOADS_DIR="server/uploads"

# Seed admin credentials
SEED_ADMIN_FULL_NAME="System Admin"
SEED_ADMIN_EMAIL="admin@jsrhotels.com"
SEED_ADMIN_PASSWORD="Admin@123"
